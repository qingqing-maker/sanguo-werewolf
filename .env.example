# 三国狼人杀 - 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# LLM Provider 选择: openai / siliconflow / deepseek / volcengine / gemini / anthropic / mock
LLM_PROVIDER=mock

# Anthropic 配置（LLM_PROVIDER=anthropic 时使用）
# 官方 API 使用 https://api.anthropic.com；代理服务请填写代理要求的地址、模型和 Key
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OpenAI 兼容接口风格：chat_completions（默认）或 responses
# 火山方舟要求通过 /api/v3/responses 调用的模型请设置为 responses
LLM_API_STYLE=chat_completions

# Gemini 配置
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# 真实 LLM 的跨进程硬预算（启用非 mock Provider 时均为必填）
LLM_TOKEN_BUDGET=100000
LLM_CALL_BUDGET=300
# Provider 调用失败后的 Mock 兜底策略：
#   none       = 禁用（默认；异常交给 BaseAgent 决策级兜底）
#   transient  = timeout / parse / empty 时，本次调用转 Mock
#   on_error   = 除 budget / billing / authentication 外，本次调用转 Mock
#   on_budget  = 仅预算耗尽后转 Mock；后续报告会将这些局标为 mixed
LLM_FALLBACK_STRATEGY=none
# 单次 Provider 请求超时（毫秒，5000-600000）；当前对 OpenAI 兼容接口与 Anthropic 生效
LLM_TIMEOUT_MS=60000
# 瞬时错误的最大重试次数（默认 4，上限 10）；重试采用指数退避
# cancel/restart 会通过 AbortSignal 中止本地请求等待与 retry sleep；取消不触发 fallback、熔断或降级，且不保证服务端停止已开始的推理
LLM_MAX_RETRIES=4
# 可选：云端将运行数据放到持久磁盘。未配置时默认使用项目目录下的 runs/ 与 game-logs/。
# DATA_DIR=/var/data
# EVENT_LOG_DIR=/var/data/game-logs
# 可选：显式覆盖账本；不配置时按 DATA_DIR + LLM_MODEL_ID 自动派生。
# LLM_BUDGET_LEDGER_PATH=/var/data/runs/llm-budget-production-v1.jsonl
# LLM_BUDGET_PERIOD=production-v1

# 服务器配置
PORT=3000
# 位于可信反向代理后方时设为 1（Render 配置已启用）。
TRUST_PROXY=0
# 主持人最后一个连接断开后的空闲房间释放宽限期；进行中的对局会等到结束再开始释放。
HOST_DISCONNECT_GRACE_MS=90000
# 开局/重开共享冷却；暂停/继续/取消使用较短冷却。0 仅建议用于离线测试。
CONTROL_COOLDOWN_MS=10000
MINOR_CONTROL_COOLDOWN_MS=1000

# ============================================================
# TTS 语音合成配置
# ============================================================
# TTS 后端选择: edge / volc
#   edge（默认）- 微软 Edge TTS，免费、无需密钥、无额度限制，适合测试
#   volc        - 火山引擎 TTS，需下方 TTS_APP_ID / TTS_ACCESS_TOKEN，有免费额度上限
TTS_PROVIDER=edge

# 火山引擎 TTS 配置（仅 TTS_PROVIDER=volc 时需要）
# TTS_APP_ID=your-tts-app-id
# TTS_ACCESS_TOKEN=your-tts-access-token
# TTS_CLUSTER=volcano_tts

# TTS 核心防护（设置页可修改，均为非敏感配置）
TTS_MAX_TEXT_CHARACTERS=1024
TTS_RATE_WINDOW_MS=60000
TTS_SESSION_REQUEST_LIMIT=30
TTS_SESSION_CHARACTER_LIMIT=8000
TTS_IP_REQUEST_LIMIT=100
TTS_IP_CHARACTER_LIMIT=30000
TTS_CONCURRENCY=2
TTS_QUEUE_LIMIT=8
TTS_TIMEOUT_MS=15000

# 付费 TTS 独立硬预算。volc 必须明确启用且完整配置，否则 fail closed；edge 默认可设为 0。
TTS_BUDGET_ENABLED=0
# volc 示例：启用后以下四项均须明确配置，账本路径必须为绝对路径。
# TTS_CHARACTER_BUDGET=100000
# TTS_CALL_BUDGET=300
# TTS_BUDGET_LEDGER_PATH=E:/absolute/path/to/sanguo-werewolf/runs/tts-budget-2026-08.jsonl
# TTS_BUDGET_PERIOD=2026-08-approved
